<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="17dp"
    app:cardElevation="0dp"
    app:strokeColor="#EAEAEA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="17dp">

        <!-- TOP -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- BLOOD GROUP -->

            <TextView
                android:id="@+id/txtBloodGroup"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_staff_blood_circle"
                android:gravity="center"
                android:text="A+"
                android:textColor="#EF2637"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- DONOR -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDonorName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Donor Name"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDonorId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="D-000000"
                    android:textColor="#888888"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- STATUS -->

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_staff_filter"
                android:gravity="center"
                android:minWidth="75dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Pending"
                android:textColor="#EF2637"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="#F0F0F0" />

        <!-- DATE + TIME -->

        <TextView
            android:id="@+id/txtDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="30 Sep 2026  •  01:00 PM - 03:00 PM"
            android:textColor="#555555"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- HOSPITAL -->

        <TextView
            android:id="@+id/txtHospital"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Divisional Hospital - Akurana"
            android:textColor="#777777"
            android:textSize="10sp" />

        <!-- ACTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tap to view appointment and check in donor →"
            android:textColor="#EF2637"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>